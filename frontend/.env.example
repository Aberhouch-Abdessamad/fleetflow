# Base URL of the API as seen by the browser. Leave as /api/v1 in development
# (Vite proxies it to VITE_API_PROXY_TARGET). In production point it to the API origin.
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_APP_NAME=FleetFlow

# All maps use Leaflet with OpenStreetMap/CARTO tiles — no API keys needed.

# Optional: real-time via Laravel Reverb (see README). Leave empty to use polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
